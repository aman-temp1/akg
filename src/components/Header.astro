---
import { NAV, SITE } from '@/lib/site';
import Roll from './Roll.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header" transition:persist="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" data-magnetic aria-label="Aman Gupta, home">
      <Roll text="Aman Gupta" />
    </a>
    <div class="clock mono muted" aria-label={`Local time in ${SITE.location}`}>
      <span>Pune, IN</span>
      <span data-clock>--:--</span>
    </div>
    <nav class="nav" aria-label="Primary">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                <Roll text={item.label} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="header-actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme">
        <span class="theme-dot" aria-hidden="true"></span>
      </button>
      <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu">
        <span class="mono">Menu</span>
      </button>
    </div>
  </div>
</header>
  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
  <ul class="wrap">
    {
      NAV.map((item, i) => (
        <li>
          <a href={item.href}>
            <span class="mono muted">{String(i + 1).padStart(2, '0')}</span>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    mix-blend-mode: difference;
    color: #fff;
    pointer-events: none;
    transition: transform 0.7s var(--ease);
  }
  :global(html.header-hidden:not(.menu-open)) .site-header {
    transform: translateY(-100%);
  }
  .site-header :global(a),
  .site-header button {
    pointer-events: auto;
  }
  .header-inner {
    height: var(--header-h);
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--gutter);
  }
  .brand {
    font-weight: 600;
    letter-spacing: -0.02em;
    font-size: 1rem;
  }
  .clock {
    display: none;
    gap: 0.75em;
  }
  .clock {
    color: #fff;
    opacity: 0.6;
  }
  .nav {
    display: none;
  }
  .nav ul {
    display: flex;
    gap: clamp(16px, 2.4vw, 36px);
  }
  .nav a {
    font-size: 0.9375rem;
    position: relative;
    display: inline-block;
  }
  .nav a[aria-current='page']::before {
    content: '';
    position: absolute;
    left: -12px;
    top: 50%;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    transform: translateY(-50%);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .theme-toggle {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .theme-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
    transition: transform 0.6s var(--ease);
  }
  :global([data-theme='dark']) .theme-dot {
    transform: rotate(180deg);
  }
  .menu-toggle {
    cursor: pointer;
    padding: 8px 0;
  }
  @media (min-width: 900px) {
    .header-inner {
      grid-template-columns: 1fr auto auto auto;
    }
    .clock {
      display: inline-flex;
      justify-self: center;
    }
    .nav {
      display: block;
    }
    .menu-toggle {
      display: none;
    }
  }
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: var(--ink);
    color: var(--bg);
    padding-top: calc(var(--header-h) + 32px);
    pointer-events: auto;
  }
  .mobile-menu ul {
    display: grid;
    gap: 4px;
  }
  .mobile-menu a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    font-size: clamp(2.75rem, 13vw, 5rem);
    letter-spacing: -0.045em;
    line-height: 1.05;
    font-weight: 500;
  }
  .mobile-menu .muted {
    color: var(--bg);
    opacity: 0.5;
  }
</style>
