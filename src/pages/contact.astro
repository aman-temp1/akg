---
import Base from '@/layouts/Base.astro';
import Roll from '@/components/Roll.astro';
import { SITE, SOCIALS } from '@/lib/site';
const formspree = import.meta.env.PUBLIC_FORMSPREE_ID as string | undefined;
---

<Base title="Contact" description="Get in touch with Aman Gupta about GenAI products, full-stack work or collaboration." footer={false}>
  <section class="wrap contact" data-hero>
    <p class="mono muted" data-reveal data-delay="0.2">Contact</p>
    <h1 class="display h-xl" data-reveal="chars">Say hello.</h1>
    <p class="lead muted intro" data-reveal data-delay="0.35">
      Open to full-time roles, freelance GenAI and full-stack projects, and good conversations about building with AI.
    </p>
    <button type="button" class="email" data-copy={SITE.email} data-cursor-text="Copy" data-reveal data-delay="0.45">
      <span data-copy-label>{SITE.email}</span>
    </button>
  </section>

  <section class="wrap contact-grid">
    <form
      class="form"
      data-contact-form
      data-fade
      method="POST"
      action={formspree ? `https://formspree.io/f/${formspree}` : `mailto:${SITE.email}`}
      data-mode={formspree ? 'formspree' : 'mailto'}
    >
      <label>
        <span class="mono muted">Name</span>
        <input name="name" autocomplete="name" required />
      </label>
      <label>
        <span class="mono muted">Email</span>
        <input name="email" type="email" autocomplete="email" required />
      </label>
      <label class="full">
        <span class="mono muted">Message</span>
        <textarea name="message" rows="5" required></textarea>
      </label>
      <div class="full form-foot">
        <button type="submit" class="btn btn-solid" data-magnetic><Roll text="Send message" /></button>
        <p class="mono muted" data-form-status role="status"></p>
      </div>
    </form>

    <aside class="side" data-fade data-delay="0.1">
      <div>
        <p class="mono muted">Elsewhere</p>
        <ul>
          {
            SOCIALS.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener">
                  <Roll text={s.label} /> ↗
                </a>
              </li>
            ))
          }
          <li><a href={SITE.resume} target="_blank" rel="noopener"><Roll text="Resume" /> ↗</a></li>
        </ul>
      </div>
      <div>
        <p class="mono muted">Based in</p>
        <p>{SITE.location}<br /><span class="muted" data-clock>--:--</span></p>
      </div>
    </aside>
  </section>
</Base>

<style>
  .contact {
    padding-top: calc(var(--header-h) + clamp(80px, 14vw, 200px));
    padding-bottom: clamp(56px, 7vw, 100px);
    display: grid;
    gap: 24px;
    border-bottom: 1px solid var(--line);
  }
  .intro {
    max-width: 30ch;
  }
  .email {
    justify-self: start;
    font-size: clamp(1.75rem, 6vw, 5.5rem);
    letter-spacing: -0.045em;
    font-weight: 500;
    cursor: pointer;
    text-align: left;
    margin-top: 24px;
    word-break: break-all;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 100% 2px;
    padding-bottom: 0.08em;
  }
  .contact-grid {
    display: grid;
    gap: 64px var(--gutter);
    padding-block: clamp(56px, 8vw, 120px) clamp(96px, 12vw, 160px);
  }
  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .form {
      grid-column: 1 / span 7;
    }
    .side {
      grid-column: 9 / span 4;
    }
  }
  .form {
    display: grid;
    gap: 28px var(--gutter);
  }
  @media (min-width: 700px) {
    .form {
      grid-template-columns: 1fr 1fr;
    }
    .full {
      grid-column: 1 / -1;
    }
  }
  label {
    display: grid;
    gap: 10px;
  }
  input,
  textarea {
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line);
    padding: 10px 0;
    font-size: 1.25rem;
    color: var(--ink);
    resize: vertical;
    transition: border-color 0.4s var(--ease);
    border-radius: 0;
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-bottom-color: var(--ink);
  }
  .form-foot {
    display: flex;
    gap: 20px;
    align-items: center;
    flex-wrap: wrap;
  }
  .side {
    display: grid;
    gap: 40px;
    align-content: start;
  }
  .side ul {
    display: grid;
    gap: 6px;
    margin-top: 12px;
    font-size: 1.25rem;
  }
  .side p + p {
    margin-top: 12px;
    font-size: 1.25rem;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form) return;
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      if (form.dataset.mode === 'mailto') {
        const subject = encodeURIComponent(`Hello from ${data.get('name')}`);
        const body = encodeURIComponent(`${data.get('message')}\n\n${data.get('name')} <${data.get('email')}>`);
        location.href = `${form.action}?subject=${subject}&body=${body}`;
        status.textContent = 'Opening your email app…';
        return;
      }
      status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error();
        form.reset();
        status.textContent = 'Thanks, I’ll reply soon.';
      } catch {
        status.textContent = 'Something went wrong. Email me directly instead.';
      }
    });
  });
</script>
